---
// Sección de una categoría: título, partidas editables y botón para añadir.
import { formatCents, centsToInput } from '../lib/money';
import type { CategoryGroup } from '../lib/types';
import IconSlot from './IconSlot.astro';

interface Props {
  group: CategoryGroup;
  year: number;
  month: number;
}
const { group, year, month } = Astro.props;
const accent = group.type === 'income' ? 'income' : group.type === 'savings' ? 'savings' : 'expense';
---

<section class="section" data-type={group.type} data-category-id={group.id}>
  <header class="section-head">
    <IconSlot size={18} />
    <h2 class="section-title">{group.name}</h2>
    <span class="section-total" data-category-id={group.id} data-accent={accent}>
      {formatCents(group.totalCents)}
    </span>
  </header>

  {group.items.length > 0 ? (
    <ul class="items">
      {group.items.map((row) => (
        <li class="item">
          <input
            class="item-name"
            type="text"
            value={row.name}
            data-item-id={row.id}
            aria-label={`Nombre de ${row.name}`}
          />
          <input
            class="amount-input"
            type="text"
            inputmode="decimal"
            value={centsToInput(row.amountCents)}
            data-item-id={row.id}
            data-type={group.type}
            data-cents={row.amountCents ?? 0}
            data-year={year}
            data-month={month}
            placeholder="0,00"
            aria-label={`Importe de ${row.name}`}
          />
          <button class="item-delete" type="button" data-item-id={row.id} aria-label={`Borrar ${row.name}`}>
            ×
          </button>
        </li>
      ))}
    </ul>
  ) : (
    <p class="empty">Sin partidas todavía.</p>
  )}

  <form class="add-form" data-category-id={group.id}>
    <input class="add-input" type="text" name="name" placeholder="Nueva partida…" maxlength="100" aria-label="Nombre de la nueva partida" />
    <button class="add-button" type="submit">Añadir</button>
  </form>
</section>

<style>
  .section {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .section-head {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .section-title {
    flex: 1;
    font-size: 15px;
    font-weight: 650;
  }

  .section-total {
    font-size: 14px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }

  .section-total[data-accent='income'] {
    color: var(--income);
  }

  .section-total[data-accent='expense'] {
    color: var(--expense);
  }

  .section-total[data-accent='savings'] {
    color: var(--savings);
  }

  .items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .item {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .item-name {
    flex: 1;
    min-width: 0;
    border: none;
    background: transparent;
    color: var(--ink);
    padding: 6px 4px;
    border-radius: 6px;
  }

  .item-name:focus {
    background: var(--bg);
    outline: none;
    box-shadow: 0 0 0 1.5px var(--brand);
  }

  .amount-input {
    width: 6.5em;
    text-align: right;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 6px 8px;
    background: var(--bg);
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .item-delete {
    flex: none;
    width: 28px;
    height: 28px;
    border: none;
    background: transparent;
    color: var(--muted);
    font-size: 18px;
    line-height: 1;
    border-radius: 6px;
  }

  .item-delete:hover {
    background: #fee2e2;
    color: var(--danger);
  }

  .empty {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
    padding: 4px;
  }

  .add-form {
    display: flex;
    gap: 8px;
    margin-top: 2px;
  }

  .add-input {
    flex: 1;
    min-width: 0;
    border: 1px dashed var(--border);
    border-radius: 8px;
    padding: 7px 10px;
    background: transparent;
    color: var(--ink);
  }

  .add-button {
    flex: none;
    border: none;
    border-radius: 8px;
    padding: 7px 14px;
    background: var(--brand);
    color: #fff;
    font-weight: 600;
  }

  .add-button:hover {
    background: var(--brand-strong);
  }
</style>
