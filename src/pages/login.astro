---
// Pantalla de inicio de sesión (privada, mobile-first, SSR sin JS).
import Layout from '../layouts/Layout.astro';

const errorCode = Astro.url.searchParams.get('error');
const errorMessage =
  errorCode === 'bad' ? 'Contraseña incorrecta.' :
  errorCode === 'setup' ? 'Configuración incompleta.' :
  '';
---

<Layout title="Iniciar sesión">
  <main class="login">
    <div class="login-card">
      <div class="login-head">
        <h1>Acceso al presupuesto</h1>
        <p class="login-sub">Bienvenido a la economía de tu hogar.</p>
      </div>

      <form method="POST" action="/api/login" class="login-form">
        <label class="field">
          <span class="field-label">Contraseña</span>
          <input
            type="password"
            name="password"
            autocomplete="current-password"
            placeholder="Tu contraseña"
            required
          />
        </label>

        <label class="remember">
          <input type="checkbox" name="remember" />
          <span>Recuérdame</span>
        </label>

        {errorMessage && <p class="login-error" role="alert">{errorMessage}</p>}

        <button class="login-button" type="submit">Entrar</button>
      </form>
    </div>
  </main>
</Layout>

<style>
  .login {
    max-width: 420px;
    margin: 0 auto;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    padding: 20px;
  }

  .login-card {
    width: 100%;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 28px 20px;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .login-head {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .login-head h1 {
    font-size: 20px;
  }

  .login-sub {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
  }

  .login-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .field-label {
    color: var(--muted);
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .field input {
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 11px 12px;
    background: var(--bg);
    color: var(--ink);
  }

  .remember {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--ink);
    font-size: 14px;
    cursor: pointer;
  }

  .remember input {
    width: 16px;
    height: 16px;
  }

  .login-error {
    margin: 0;
    color: var(--danger);
    font-size: 14px;
  }

  .login-button {
    border: none;
    border-radius: 8px;
    padding: 12px;
    background: var(--brand);
    color: #fff;
    font-weight: 600;
    font-size: 16px;
  }

  .login-button:hover {
    background: var(--brand-strong);
  }
</style>
